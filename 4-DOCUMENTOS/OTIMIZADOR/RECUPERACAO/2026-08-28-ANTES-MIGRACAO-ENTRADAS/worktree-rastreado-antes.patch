-      const par=alvos.filter(k=>idx[k]!==undefined);
-      if(par.length<alvos.length) continue;
-      if(log)log('   '+nome+' R='+R+' id@'+idoff+' → as '+par.length+' cartas do gabarito estão aqui');
-      for(let bit=0;bit<R*8-8;bit++){
