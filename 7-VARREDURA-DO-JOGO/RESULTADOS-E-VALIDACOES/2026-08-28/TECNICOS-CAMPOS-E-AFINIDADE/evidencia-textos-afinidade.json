          "tamanho_armazenado": 74,
          "tamanho_visivel": 70
        },
        {
          "secao": "Any8T",
          "secao_idx": 21,
          "id_texto": 605,
          "texto": "Aumenta a quantidade de experiência que os jogadores recebem por disputar partidas. O tipo de afinidade definirá quais jogadores receberão esse benefício.",
          "idioma": "pt-BR",
          "arquivo": "all.str",
