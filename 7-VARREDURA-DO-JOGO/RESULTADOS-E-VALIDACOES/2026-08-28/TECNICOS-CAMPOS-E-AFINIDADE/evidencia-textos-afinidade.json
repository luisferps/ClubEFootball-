          "entrada_offset": 460884,
          "texto_offset": 505531,
          "tamanho_armazenado": 404,
          "tamanho_visivel": 390
        },
        {
          "secao": "Any8T",
          "secao_idx": 21,
          "id_texto": 480,
          "texto": "Partida importante a seguir. Suas opções de Nível da partida foram restringidas. Você receberá Pontos da Minha Liga e pontos de experiência adicionais.",
          "idioma": "pt-BR",
          "arquivo": "all.str",
          "cpk": "dt261_bra_console_win.cpk",
          "secao_cabecalho_idx": 21,
          "secao_offset": 456016,
