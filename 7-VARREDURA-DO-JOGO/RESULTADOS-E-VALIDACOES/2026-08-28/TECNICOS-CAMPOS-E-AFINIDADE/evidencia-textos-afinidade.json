          "entrada_offset": 461748,
          "texto_offset": 509837,
          "tamanho_armazenado": 158,
          "tamanho_visivel": 151
        },
        {
          "secao": "Any8T",
          "secao_idx": 21,
          "id_texto": 496,
          "texto": "Você receberá Pontos da Minha Liga e pontos de experiência adicionais.",
          "idioma": "pt-BR",
          "arquivo": "all.str",
          "cpk": "dt261_bra_console_win.cpk",
          "secao_cabecalho_idx": 21,
          "secao_offset": 456016,
