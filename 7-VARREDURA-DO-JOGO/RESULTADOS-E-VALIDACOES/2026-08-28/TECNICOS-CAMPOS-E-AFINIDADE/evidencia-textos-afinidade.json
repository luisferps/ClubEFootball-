        },
        {
          "secao": "Any9T",
          "secao_idx": 22,
          "id_texto": 490,
          "texto": "Hat tricks contra adversários Superastros ou mais avançados: %d",
          "idioma": "pt-BR",
          "arquivo": "all.str",
