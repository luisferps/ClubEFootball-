
async function postJsonReport(url, body, timeoutMs = 0) {
  const controller = timeoutMs ? new AbortController() : null;
  const timeout = controller ? setTimeout(() => controller.abort(), timeoutMs) : null;
  let response;
  try {
    response = await fetchWithContract(url, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ ...body, leitura_contrato: contractSeal() }),
      signal: controller ? controller.signal : undefined
    });
  } catch (error) {
    if (error && error.name === 'AbortError') {
      throw new Error('A família demorou além do limite seguro; o restante da varredura continuará.');
    }
    throw error;
  } finally {
    if (timeout) clearTimeout(timeout);
  }
  const payload = await response.json().catch(() => ({ error: `HTTP ${response.status}` }));
  assertContractResponse(response, payload);
  if (!response.ok && typeof payload.passed !== 'boolean' && payload.continue_pipeline !== true) {
    throw new Error(payload.error || `HTTP ${response.status}`);
  }
  return payload;
}

